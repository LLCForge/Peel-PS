{
  "name": "peel-ps",
  "version": "0.1.0",
  "description": "Open-source PowerShell deobfuscator that runs in your browser. Your code never leaves your device.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "peel-ps": "bin/peel-ps.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLCForge/Peel-PS.git"
  },
  "homepage": "https://github.com/LLCForge/Peel-PS#readme",
  "keywords": [
    "deobfuscator",
    "powershell",
    "invoke-obfuscation",
    "malware-analysis",
    "security"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/run.js && node test/all.js",
    "bench": "node test/bench.js",
    "fixtures": "node scripts/make-fixtures.js && node scripts/make-analyze-fixtures.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "vite": "^6.4.6"
  }
}
